[14.605955, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"rejected_by_risk\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"alert_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"hello-big\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"violations\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"code\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"qty_exceeds_max_per_order\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"detail\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"qty 5000 > max_qty_per_order 100\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"code\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"position_limit_exceeded\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"detail\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"projected position 5010 would exceed max_position_per_symbol 250\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
