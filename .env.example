# Copy to .env (or run `make init`, which generates random secrets for you).
# Every value below is a placeholder. Never commit a real .env.

# --- Required -------------------------------------------------------------
# Shared secret TradingView sends in the alert body ("secret" field) or in the
# X-Webhook-Secret header. 16+ characters. The loader refuses placeholders.
WEBHOOK_SECRET=replace-with-a-long-random-string
# Separate secret for /admin/kill (header X-Admin-Secret). Must differ from WEBHOOK_SECRET.
ADMIN_SECRET=replace-with-a-different-long-random-string

# --- Broker ---------------------------------------------------------------
# sim = in-process paper broker (default). alpaca_paper = Alpaca paper REST API.
BROKER=sim

# Only read when BROKER=alpaca_paper. Paper-trading keys only.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# The adapter refuses to start unless this is the paper endpoint.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Paths and timing (all optional; values shown are the defaults) --------
# RISK_CONFIG_PATH=config/risk.yaml
# DB_PATH=data/bridge.db
# HEARTBEAT_PATH=data/heartbeat.json
# LOG_LEVEL=INFO
# LOG_FILE=              # also write JSON logs to this file (rotating)
# RECONCILE_INTERVAL_S=30
# HEARTBEAT_INTERVAL_S=5

# --- Order delivery (all optional) ------------------------------------------
# BROKER_TIMEOUT_S=2     # per broker HTTP call
# SUBMIT_ATTEMPTS=3      # tries per alert before the order is parked as "unknown"
# SUBMIT_BACKOFF_S=0.2   # doubles after each failed attempt
# UNKNOWN_GRACE_S=120    # how long an unconfirmed order may be retried before it is failed

# --- SimBroker behaviour (all optional; defaults are deterministic) --------
# SIM_LATENCY_MS=0
# SIM_PARTIAL_FILL_PROB=0.0   # 0..1: share of orders that fill in two chunks
# SIM_REJECT_PROB=0.0         # 0..1: share of orders the sim rejects
# SIM_SEED=                   # integer: make the random behaviour reproducible
# SIM_DEFAULT_PRICE=100.00    # reference price for every symbol
